{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "fliphtml5-downloader",
    // 构建产物入口。scripts/inject-cron-handler.ts 会在构建后直接向本文件注入 scheduled 处理器
    // （保留 OpenNext 对 .build/durable-objects/* 的外部化解析，不能换成外部包装入口）。
    "main": ".open-next/worker.js",
    "compatibility_date": "2025-09-01",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    // Workers Cache：Cloudflare 在调用 Worker 前先查边缘缓存，命中时 Worker 完全不执行
    // （0 CPU、不打 D1）。本项目不做数据层缓存（见 open-next.config.ts），整页缓存全靠这层。
    // 可缓存性由响应的 Cache-Control 决定，各前端页面的
    // max-age（1 小时 / 1 天 / 1 周三档）由 scripts/inject-cron-handler.ts 在构建后注入。
    // 注意：开启后静态资产请求也开始按 Workers 请求数计费（CPU 不计费）。
    // 不设 cross_version_cache，保留「每次部署自动失效」这个默认逃生口。
    "cache": {
        "enabled": true
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        }
    },
    // Cloudflare Cron Triggers（UTC）。需与 scripts/inject-cron-handler.ts 的 CRON_MAP
    // 以及 vercel.json 的 Vercel Cron 计划保持一致。
    "triggers": {
        "crons": [
            "0 0 * * *",
            "30 0 * * *",
            // "0 1 * * *"
        ]
    },
    "routes": [
        {
            "pattern": "fliphtml5.aivaded.com",
            "custom_domain": true,
        },
    ],
    // 在 Cloudflare 创建 D1 后，把真实 database_id 回填到这里。
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "flipbook-db",
            "database_id": "b2683b18-ee97-44c6-8bcf-63181686dc44",
            "migrations_dir": "drizzle/d1"
        }
    ],
    // D1 结果缓存：仅缓存「读行数随结果集增长、索引无法收敛」的重查询
    // （sitemap / 相关书籍 / 日期清单 / 单日书籍），见 lib/db/repositories/d1-cache.ts。
    // 由 `wrangler kv namespace create BOOKS_CACHE` 创建。
    "kv_namespaces": [
        {
            "binding": "BOOKS_CACHE",
            "id": "851bf04daf57435b91a951f7bcc0282d"
        }
    ],
    // Cloudflare Email Sending：Workers 原生发送绑定（无需 API key），代码经 getCloudflareContext().env.EMAIL 调用。
    // 前提：发件域名须先开通 Email Sending（`npx wrangler email sending enable aivaded.com`）并配好 SPF/DKIM，
    // 否则发送会以 E_SENDER_NOT_VERIFIED 失败（best-effort 静默跳过，后台仍可手动复制码发送）。
    "send_email": [
        {
            "name": "EMAIL"
        }
    ],
    // Workers 运行时环境变量。数据库驱动选择 + 非明文配置。
    // 机密（CRON_SECRET / DISCORD_WEBHOOK_URL / SEO_SUBMIT_URL 等）请用 `wrangler secret put`，不要写在这里。
    "vars": {
        "DB_DRIVER": "d1",
        "NEXT_PUBLIC_BASE_URL": "https://fliphtml5.aivaded.com",
        "PROJECT_ID": "fliphtml5-downloader",
        "NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL": "https://plausible.aivaded.com/api/loader/fliphtml5-downloader.js",
        "DISCORD_WEBHOOK_URL": "https://plausible.aivaded.com/api/discord/webhook/fliphtml5-downloader",
        "SEO_SUBMIT_URL": "https://plausible.aivaded.com/api/seo/submit/fliphtml5-downloader",
        // PayPal 支付网关（仅 /api/payment/* 服务端使用）。填入平台分配的 sk_xxx 密钥后即可生效；
        // 也可改用 `wrangler secret put PAYMENT_API_KEY`。
        "PAYMENT_BASE_URL": "https://payment.aivaded.com",
        "PAY_DEBUG": "false",
        // FREE_ONCE_EVERYDAY=false 时取消「每天首次下载免费」额度，所有文件都需解锁（付费或 Discord 兑换码）。
        "FREE_ONCE_EVERYDAY": "false",
        // FREE_CODE_ENABLE=false 时前端隐藏免费券（Discord / X 码）兑换入口，仅隐藏 UI，兑换接口仍可用。
        "FREE_CODE_ENABLE": "true",
        // PAYMENT_ENABLE=false 时关闭支付入口：弹窗隐藏付费按钮、/api/payment/create-order 不再接受下单。
        // 搭配 FREE_CODE_ENABLE=true 表示暂时只支持通过 Discord / X 获取免费券解锁。
        "PAYMENT_ENABLE": "false",
        // Discord/X 免费券运营参数（运行时生效，改动无需重新构建；留空或删除则回退代码默认值）。
        // WEEK_PASS_DAYS：每次激活的周卡天数；DISCORD_PASS_MAX_USES：每张码可激活次数；
        // DISCORD_PASS_BATCH_SIZE：每日 00:00 UTC cron 固定发放的码数量（不受 MAX 限制）；DISCORD_PASS_BATCH_MAX：后台手动单批生成的数量上限。
        "WEEK_PASS_DAYS": "1",
        "DISCORD_PASS_MAX_USES": "1",
        "DISCORD_PASS_BATCH_SIZE": "10",
        "DISCORD_PASS_BATCH_MAX": "10",
        // Twitter 发帖换券：后台审核通过后经 Cloudflare Email Sending 向用户邮箱发送兑换码的发件地址（须是已开通 Email Sending 的域名）。
        // 留空则不自动发信，后台页可复制兑换码手动发送。
        "FREE_PASS_EMAIL_FROM": "hello@aivaded.com"
    }
    // 多账号时需指定: "account_id": "<your-account-id>"
}