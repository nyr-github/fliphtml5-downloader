{
  "name": "fliphtml5-downloader-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 10022",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "python3 -m http.server 10022 --bind 127.0.0.1 --directory out",
    "lint": "eslint app components lib tests next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.5.29",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "^16.0.8",
    "postcss": "^8.5.23",
    "tailwindcss": "4.1.11",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "playwright": "^1.56.1",
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
