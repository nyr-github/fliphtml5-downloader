# Neon Database URL
DATABASE_URL=

# 数据库驱动选择：留空/不设置 = postgres (Vercel/VPS 默认)；设为 d1 = Cloudflare D1 (Workers)。
# Workers 侧该值由 wrangler.jsonc 的 [vars] DB_DRIVER 注入，本地无需设置。
DB_DRIVER=

# Base URL for the application (used for sitemap and robots.txt)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Cron job secret for authorization
CRON_SECRET=

# Plausible Analytics script URL
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Discord Webhook URL for daily stats
DISCORD_WEBHOOK_URL=

# SEO Submission API URL
SEO_SUBMIT_URL=

# External Blog Project ID
PROJECT_ID=fliphtml5-downloader

# Payment gateway (PayPal) - used by /api/payment/* server routes only, never exposed to frontend.
# API key is issued by the payment platform operator.
PAYMENT_BASE_URL=https://payment.aivaded.com
PAYMENT_API_KEY=
# PAY_DEBUG=true 时，两个交易金额均降为 $0.10（10 分）用于测试支付链路，上线前需关闭。
PAY_DEBUG=
# FREE_ONCE_EVERYDAY=false 时取消「每天首次下载免费」，所有文件都需解锁（付费或兑换码）；
# 不设置/其他值 = 开启每日免费额度。
FREE_ONCE_EVERYDAY=
# FREE_CODE_ENABLE=false 时前端不展示免费券（Discord / X 码）兑换入口，只隐藏 UI，接口仍可用。
FREE_CODE_ENABLE=
# PAYMENT_ENABLE=false 时关闭支付入口：弹窗隐藏付费按钮，/api/payment/create-order 拒绝下单；
# 若同时 FREE_CODE_ENABLE=true（默认），表示暂时只支持通过 Discord / X 获取免费券解锁。
PAYMENT_ENABLE=

# Discord 社区通行证：后台管理统一路径令牌（随机长字符串）。
# 配置后可访问 /admin/<ADMIN_TOKEN>/passes 批量生成兑换码并发送到 DISCORD_WEBHOOK_URL；未配置则后台 404。
ADMIN_TOKEN=

# ---- Discord/X 免费券运营参数（运行时生效，非法/缺省则回退代码默认值）----
# 每次激活的周卡天数（默认 7）
WEEK_PASS_DAYS=
# 每张码可激活次数（默认 5）
DISCORD_PASS_MAX_USES=
# 每日 00:00 UTC cron 固定发放的码数量（默认 10，不受下面的 MAX 限制）
DISCORD_PASS_BATCH_SIZE=
# 后台手动单批生成的数量上限（默认 50；仅约束后台 generate，不影响每日定时发放）
DISCORD_PASS_BATCH_MAX=

# ---- Twitter/X 发帖换免费券 ----
# 用户在 /free-pass 提交「X 帖子链接 + 接收邮箱」，后台 /admin/<ADMIN_TOKEN>/requests 审核后发放专属码。
# 审核通过时经 Cloudflare Email Sending（Workers send_email 绑定）向用户邮箱发兑换码的发件地址（须是已开通 Email Sending 的域名）。
# 留空则不自动发信，后台页复制兑换码手动发送。
FREE_PASS_EMAIL_FROM=

# 后台「检查帖子有效性」（/api/admin/<ADMIN_TOKEN>/requests/check-tweet）调用 twitter-api45 (RapidAPI) 的 key。
# 生产环境已在 wrangler.jsonc vars 中默认配置；本地如需覆盖可在此填写。
# RAPIDAPI_TWITTER_KEY=
